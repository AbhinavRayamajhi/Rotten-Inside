# Handle line endings automatically for text files
* text=auto eol=lf

# Force Godot text files to use LF line endings
*.tscn text eol=lf
*.tres text eol=lf
*.gd text eol=lf
*.cfg text eol=lf
*.godot text eol=lf
*.project text eol=lf

# Explicitly treat binary assets as binary (do not modify line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg binary
*.ico binary

*.wav binary
*.ogg binary
*.mp3 binary

*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

*.blend binary
*.fbx binary
*.obj binary
*.dae binary
*.gltf binary
*.glb binary

*.zip binary
*.tar binary
*.gz binary